# Generate a private key with: openssl rand -hex 32
API_KEY=
# Host port used by Docker Compose.
API_PORT=8787
MAX_CONCURRENT_RENDERS=2
RATE_LIMIT_PER_MINUTE=60
# Browser origins allowed to read and report website statistics.
STATS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
STATS_RATE_LIMIT_PER_MINUTE=120
# Native API only; Compose stores this database in its stats-data volume.
STATS_DB_PATH=data/stats.sqlite
